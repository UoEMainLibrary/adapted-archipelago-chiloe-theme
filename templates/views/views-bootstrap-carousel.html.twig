{#
/**
 * @file
 * Default theme implementation for displaying a view as a bootstrap carousel.
 *
 * Available variables:
 * - view: The view object.
 * - rows: A list of the view's row items.
 * - id: A valid HTML ID and guaranteed to be unique.
 * - interval: The amount of time to delay between automatically cycling a
 *   slide item. If false, carousel will not automatically cycle.
 * - pause: Pauses the cycling of the carousel on mouseenter and
 *   resumes the cycling of the carousel on mouseleave.
 * - wrap: Whether the carousel should cycle continuously or have
 *   hard stops.
 *
 * WCAG 2.2 AA notes:
 * - 2.2.2 Pause, Stop, Hide: adds a visible pause/play button that toggles the
 *   Bootstrap 5 carousel via `bootstrap.Carousel.pause()` / `.cycle()`.
 *   The button appears as soon as the carousel starts cycling and is fully
 *   keyboard-operable.
 * - 4.1.2 Name, Role, Value: prev/next controls are now real `<button>`
 *   elements (Bootstrap 5's recommended pattern) instead of `<a role="button">`.
 * - 1.4.13 / 2.4.7: focus styles are handled globally by scss/accessibility.scss.
 *
 * @see template_preprocess_views_bootstrap_carousel()
 *
 * @ingroup themeable
 */
#}
{% if rows|length > 0 %}
<div id="{{ id }}" class="carousel {{ effect }}"
    data-bs-interval="{{ interval }}"
    {% if ride %} data-bs-ride="carousel" {% endif %}
     data-bs-pause="{% if pause %}hover{% else %}false{% endif %}"
     aria-roledescription="carousel"
     aria-label="{{ 'Featured collection items'|t }}"
>
  {# Show indicators if set in view. #}
  {%  if indicators %}
  <div class="carousel-indicators">
      {% for key, row in rows %}
          {% set indicator_classes = [loop.first ? 'active'] %}
          <button aria-label="{{ 'Slide @n: @title'|t({'@n': key + 1, '@title': row.title}) }}" type="button" class="{{ indicator_classes|join(' ') }}" data-bs-target="#{{ id }}" data-bs-slide-to="{{ key }}"{% if loop.first %} aria-current="true"{% endif %}>
             {{ row.title }}
          </button>
      {% endfor %}
  </div>
  {% endif %}

  {# Carousel body. #}
  <div class="carousel-inner" aria-live="polite">
    {% for row in rows %}
        {% set row_classes = ['carousel-item', loop.first ? 'active'] %}
        <div class="{{ row_classes|join(' ') }}" role="group" aria-roledescription="slide" aria-label="{{ 'Slide @n of @total'|t({'@n': loop.index, '@total': loop.length}) }}">
        {{ row.image }}
        {% if row.title or row.description %}
            {%  if use_caption %}
            <div class="carousel-caption d-none d-md-block">
            {% endif %}
            {% if row.title %}
                <h3 class="p-3 bg-quaternary text-bg-quaternary">{{ row.title }}</h3>
            {% endif %}
            {% if row.description %}
                <p>{{ row.description }}</p>
            {% endif %}
            {%  if use_caption %}
            </div>
            {% endif %}
        {% endif %}
        </div>
    {% endfor %}
  </div>

  {# Controls #}
  {% if navigation %}
    <button class="carousel-control-prev" type="button" data-bs-target="#{{ id }}" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">{{ 'Previous'|t }}</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#{{ id }}" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">{{ 'Next'|t }}</span>
    </button>
  {% endif %}

  {# 2.2.2 Pause, Stop, Hide — only rendered if the carousel actually auto-cycles. #}
  {% if ride and interval %}
    <button type="button"
            class="carousel-pause-toggle btn btn-sm"
            data-bs-target="#{{ id }}"
            aria-pressed="false"
            aria-label="{{ 'Pause carousel automatic sliding'|t }}">
      <span class="carousel-pause-toggle__icon" aria-hidden="true"></span>
      <span class="carousel-pause-toggle__label">{{ 'Pause'|t }}</span>
    </button>
  {% endif %}
</div>
{% endif %}
